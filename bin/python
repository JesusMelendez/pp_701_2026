#!/bin/bash
# Python del contenedor Spark. Así `python` en este proyecto ve pyspark.
set -euo pipefail

container=jupyter-pyspark
root=/home/agreen
inside=/home/joyvan/work

if ! docker inspect "$container" >/dev/null 2>&1; then
  echo "No está corriendo el contenedor $container." >&2
  exit 1
fi

args=()
for a in "$@"; do
  case "$a" in
    "$root"/*) args+=("$inside/${a#"$root"/}") ;;
    *) args+=("$a") ;;
  esac
done

tty_flag=()
if [ -t 0 ] && [ -t 1 ]; then
  tty_flag=(-t)
fi

exec docker exec -i "${tty_flag[@]}" \
  -w "$inside/cuidados_observatorio" \
  "$container" \
  python "${args[@]}"
